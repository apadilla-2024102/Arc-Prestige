{
  "name": "expo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--preserve-symlinks EXPO_USE_PROJECT_NODE_MODULES=1 expo start",
    "android": "cross-env NODE_OPTIONS=--preserve-symlinks EXPO_USE_PROJECT_NODE_MODULES=1 expo start --android",
    "ios": "cross-env NODE_OPTIONS=--preserve-symlinks EXPO_USE_PROJECT_NODE_MODULES=1 expo start --ios",
    "web": "cross-env NODE_OPTIONS=--preserve-symlinks EXPO_USE_PROJECT_NODE_MODULES=1 expo start --web"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "babel-preset-expo": "~12.0.0",
    "cross-env": "^7.0.3"
  }
}
